<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="180"
             x:Class="SPTInstaller.CustomControls.Dialogs.ConfirmationDialog"
             x:Name="Root"
             Width="440">
    <Border Background="{StaticResource Gray950Brush}" BorderBrush="{StaticResource Gray700Brush}" BorderThickness="1"
            CornerRadius="12" Padding="20 18">
        <StackPanel Spacing="8">
            <TextBlock Text="{Binding #Root.Message}" FontSize="15" FontWeight="SemiBold" Foreground="White"
                       TextWrapping="Wrap" />
            <TextBlock Classes="body" Text="{Binding #Root.Detail}"
                       IsVisible="{Binding #Root.Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0 10 0 0">
                <Button Content="{Binding #Root.CancelText}"
                        Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}"
                        CommandParameter="{x:False}" />
                <Button Classes="primary" Content="{Binding #Root.ConfirmText}"
                        Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}"
                        CommandParameter="{x:True}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
