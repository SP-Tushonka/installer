<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="using:SPTInstaller.Helpers"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="300"
             x:Class="SPTInstaller.CustomControls.Dialogs.WhyCacheThoughDialog"
             x:Name="Root"
             Width="500">
    <Border Background="{StaticResource Gray950Brush}" BorderBrush="{StaticResource Gray700Brush}" BorderThickness="1"
            CornerRadius="12" Padding="20 18">
        <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="What is the download cache for?" Margin="0" />
            <TextBlock Classes="body"
                       Text="It keeps the patches and the SPT download, so installing again doesn't fetch several gigabytes a second time. It also saves bandwidth on our download mirrors." />
            <TextBlock Classes="body"
                       Text="Clear it when you're low on disk space or don't plan to install again soon." />

            <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="Location" />
                <Button Classes="link" Content="{Binding Source={x:Static helpers:DownloadCacheHelper.CachePath}}"
                        IsVisible="{Binding #Root.CacheExists}" Command="{Binding #Root.OpenCacheFolder}" />
                <TextBlock Classes="muted" Text="No cache folder yet" IsVisible="{Binding !#Root.CacheExists}" />
            </StackPanel>

            <Button Classes="primary" Content="Close" HorizontalAlignment="Right" Margin="0 6 0 0"
                    Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}" />
        </StackPanel>
    </Border>
</UserControl>
