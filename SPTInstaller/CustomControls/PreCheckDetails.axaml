<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:model="using:SPTInstaller.Models"
             xmlns:cc="using:SPTInstaller.CustomControls"
             xmlns:cvt="using:SPTInstaller.Converters"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="SPTInstaller.CustomControls.PreCheckDetails">

    <UserControl.Resources>
        <cvt:BoldMarkupConverter x:Key="boldMarkup" />
        <cvt:StatusSpinnerIsStateConverter x:Key="isState" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.details">
            <Setter Property="Background" Value="{StaticResource Gray950Brush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.details.warning">
            <Setter Property="Background" Value="{StaticResource NoticeBrush}" />
        </Style>
        <Style Selector="Border.details.error">
            <Setter Property="Background" Value="{StaticResource DangerCardBrush}" />
        </Style>
        <Style Selector="Border.details TextBlock.text">
            <Setter Property="Foreground" Value="{StaticResource Gray300Brush}" />
        </Style>
        <Style Selector="Border.details.warning TextBlock.text, Border.details.error TextBlock.text">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- The amber and red icons vanish on a card of the same colour, which already says the state -->
        <Style Selector="Border.details.warning cc|StatusSpinner, Border.details.error cc|StatusSpinner">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <ItemsControl ItemsSource="{Binding PreChecks}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="model:PreCheckBase">
                    <Border Classes="details precheck-details" CornerRadius="12" BorderThickness="1"
                            IsVisible="{Binding IsSelected}"
                            Classes.warning="{Binding State, Converter={StaticResource isState}, ConverterParameter=Warning}"
                            Classes.error="{Binding State, Converter={StaticResource isState}, ConverterParameter=Error}">
                        <Grid RowDefinitions="Auto,*,Auto" Margin="18 14">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0 0 0 8">
                                <cc:StatusSpinner State="{Binding State}" />
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="White" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Classes="text" TextWrapping="Wrap"
                                       Inlines="{Binding PreCheckDetails, Converter={StaticResource boldMarkup}}" />
                            <Button Grid.Row="2" Classes="primary" Margin="0 12 0 0" HorizontalAlignment="Left"
                                    IsVisible="{Binding ActionButtonIsVisible}"
                                    Command="{Binding ActionButtonCommand}"
                                    Content="{Binding ActionButtonText}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>
</UserControl>
