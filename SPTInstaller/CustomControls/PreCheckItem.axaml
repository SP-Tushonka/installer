<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cc="using:SPTInstaller.CustomControls"
             xmlns:convt="using:SPTInstaller.Converters"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="34"
             x:Class="SPTInstaller.CustomControls.PreCheckItem"
             x:Name="Root">
    <UserControl.Resources>
        <convt:StatusSpinnerIsStateConverter x:Key="isState" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="BorderBrush" Value="{StaticResource Gray800Brush}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="2 8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.row:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#08FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource Gray800Brush}" />
        </Style>
        <Style Selector="Button.row.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#0FFFFFFF" />
        </Style>
    </UserControl.Styles>

    <Button Classes="row" Classes.selected="{Binding #Root.IsSelected}"
            Command="{Binding #Root.SelectCommand}" CommandParameter="{Binding}">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <cc:StatusSpinner State="{Binding #Root.State}" Margin="0 0 10 0" />
            <TextBlock Grid.Column="1" Text="{Binding #Root.PreCheckName}" Foreground="White"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding #Root.Summary}" Classes="muted" FontSize="12"
                       VerticalAlignment="Center"
                       IsVisible="{Binding #Root.State, Converter={StaticResource isState}, ConverterParameter=OK}" />
            <TextBlock Grid.Column="2" Text="see below" Foreground="{StaticResource WarningBrush}" FontSize="12"
                       VerticalAlignment="Center"
                       IsVisible="{Binding #Root.State, Converter={StaticResource isState}, ConverterParameter=Warning}" />
            <TextBlock Grid.Column="2" Text="see below" Foreground="{StaticResource DangerBrush}" FontSize="12"
                       VerticalAlignment="Center"
                       IsVisible="{Binding #Root.State, Converter={StaticResource isState}, ConverterParameter=Error}" />
        </Grid>
    </Button>
</UserControl>
