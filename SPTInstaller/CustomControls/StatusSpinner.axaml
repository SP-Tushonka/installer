<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:convt="using:SPTInstaller.Converters"
             mc:Ignorable="d" d:DesignWidth="20" d:DesignHeight="20"
             x:Class="SPTInstaller.CustomControls.StatusSpinner">

    <UserControl.Resources>
        <convt:StatusSpinnerIsStateConverter x:Key="IsStateConverter" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Arc">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Panel Width="16" Height="16" VerticalAlignment="Center">
        <Arc StartAngle="280" SweepAngle="100" StrokeThickness="2.5" Stroke="{StaticResource AccentBrush}"
             IsVisible="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl},
                         Converter={StaticResource IsStateConverter}, ConverterParameter=Running}" />
        <PathIcon Classes="state" Data="{StaticResource IconCircleOutline}" Foreground="{StaticResource Gray600Brush}"
                  IsVisible="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl},
                              Converter={StaticResource IsStateConverter}, ConverterParameter=Pending}" />
        <PathIcon Classes="state" Data="{StaticResource IconCheckCircle}" Foreground="{StaticResource SuccessBrush}"
                  IsVisible="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl},
                              Converter={StaticResource IsStateConverter}, ConverterParameter=OK}" />
        <PathIcon Classes="state" Data="{StaticResource IconAlert}" Foreground="{StaticResource WarningBrush}"
                  IsVisible="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl},
                              Converter={StaticResource IsStateConverter}, ConverterParameter=Warning}" />
        <PathIcon Classes="state" Data="{StaticResource IconCloseCircle}" Foreground="{StaticResource DangerBrush}"
                  IsVisible="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl},
                              Converter={StaticResource IsStateConverter}, ConverterParameter=Error}" />
    </Panel>
</UserControl>
