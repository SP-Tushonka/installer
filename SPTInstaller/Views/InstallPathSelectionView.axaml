<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cc="using:SPTInstaller.CustomControls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="460"
             x:Class="SPTInstaller.Views.InstallPathSelectionView">
    <Grid RowDefinitions="Auto,*">
        <cc:PageHeader Icon="{StaticResource IconFolder}" Title="Install folder">
            <cc:PageHeader.Actions>
                <Button Classes="primary" Command="{Binding NextCommand}" IsEnabled="{Binding CanContinue}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Continue" />
                        <PathIcon Data="{StaticResource IconArrowRight}" Width="13" Height="13" />
                    </StackPanel>
                </Button>
            </cc:PageHeader.Actions>
        </cc:PageHeader>

        <Border Grid.Row="1" Classes="content">
            <!-- Stacked so both cards span the width and neither is left with empty space -->
            <StackPanel Spacing="12" VerticalAlignment="Top">
                <Border Classes="panel">
                    <StackPanel>
                        <TextBlock Classes="h2" Text="Where should SPT go?" />
                        <TextBlock Classes="body" Margin="0 0 0 12"
                                   Text="SPT gets its own copy of the game in this folder. Your live install isn't touched." />

                        <Border x:Name="Field" Background="{StaticResource Gray800Brush}" CornerRadius="8" BorderThickness="1"
                                Padding="4 3 3 3" Classes.error="{Binding !ValidPath}">
                            <Border.Styles>
                                <Style Selector="Border#Field">
                                    <Setter Property="BorderBrush" Value="{StaticResource Gray700Brush}" />
                                </Style>
                                <Style Selector="Border#Field.error">
                                    <Setter Property="BorderBrush" Value="#9F0712" />
                                </Style>
                                <Style Selector="TextBox /template/ Border#PART_BorderElement, TextBox:pointerover /template/ Border#PART_BorderElement, TextBox:focus /template/ Border#PART_BorderElement">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                </Style>
                            </Border.Styles>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Margin="6 0 2 0"
                                          Foreground="{StaticResource Gray400Brush}" />
                                <TextBox Grid.Column="1" Text="{Binding SelectedPath}" PlaceholderText="D:\SPT"
                                         Background="Transparent" BorderThickness="0" MinHeight="0"
                                         TextChanged="TextBox_OnTextChanged" />
                                <Button Grid.Column="2" Content="Browse" Padding="12 4" Command="{Binding SelectFolderCommand}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" Margin="0 8 0 0" IsVisible="{Binding !ValidPath}" />

                        <Grid ColumnDefinitions="2*,*" Margin="0 14 0 0">
                            <StackPanel Spacing="2" Margin="0 0 16 0">
                                <TextBlock Classes="label" Text="Game folder" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="mono muted" Text="{Binding GamePath, TargetNullValue='Not found'}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="link" Content="{Binding GameButtonText}" Margin="10 0 0 0"
                                            Command="{Binding SelectGameFolderCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding GameError}" Foreground="{StaticResource DangerBrush}"
                                           TextWrapping="Wrap" Margin="0 4 0 0"
                                           IsVisible="{Binding GameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Classes="label" Text="Free space" />
                                <TextBlock Classes="muted" Text="{Binding FreeSpaceText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <cc:InfoCard Kind="warning" Title="Things to note"
                             Text="Pick an empty folder outside the game&#10;Avoid Downloads, Desktop and Program Files&#10;Downloads are cached in %appdata%\spt-installer, so a reinstall doesn't fetch them again" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
