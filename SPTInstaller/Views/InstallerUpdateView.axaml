<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cc="using:SPTInstaller.CustomControls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="460"
             x:Class="SPTInstaller.Views.InstallerUpdateView">
    <Grid RowDefinitions="Auto,*">
        <!-- Checking -->
        <cc:PageHeader Icon="{StaticResource IconRefresh}" Title="Checking for installer updates"
                       IsVisible="{Binding UpdateInfo.CheckingForUpdates}" />

        <!-- An update is available -->
        <cc:PageHeader Icon="{StaticResource IconRefresh}" Title="Installer update"
                       BadgeText="{Binding UpdateInfo.NewVersionText}">
            <cc:PageHeader.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="UpdateInfo.UpdateAvailable" />
                    <Binding Path="!UpdateInfo.Updating" />
                </MultiBinding>
            </cc:PageHeader.IsVisible>
            <cc:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Skip" Command="{Binding NotNowCommand}" />
                    <Button Classes="primary" Command="{Binding UpdateInstallCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconDownload}" Width="13" Height="13" />
                            <TextBlock Text="Update now" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </cc:PageHeader.Actions>
        </cc:PageHeader>

        <!-- Updating -->
        <cc:PageHeader Icon="{StaticResource IconDownload}" Title="Updating the installer"
                       Subtitle="{Binding UpdateInfo.UpdateInfoText}"
                       IsVisible="{Binding UpdateInfo.Updating}" />

        <Border Grid.Row="1" Classes="content">
            <Panel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10"
                            IsVisible="{Binding UpdateInfo.CheckingForUpdates}">
                    <cc:StatusSpinner State="Running" />
                    <TextBlock Text="{Binding UpdateInfo.UpdateInfoText}" Classes="muted" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="UpdateInfo.UpdateAvailable" />
                            <Binding Path="!UpdateInfo.Updating" />
                        </MultiBinding>
                    </ScrollViewer.IsVisible>
                    <cc:InfoCard Title="What's new" VerticalAlignment="Top"
                                 Text="{Binding UpdateInfo.ChangeLog, TargetNullValue='No release notes were published for this version'}" />
                </ScrollViewer>

                <Border Classes="panel" VerticalAlignment="Center" IsVisible="{Binding UpdateInfo.Updating}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding UpdateInfo.UpdateInfoText}" Classes="label" />
                            <TextBlock Grid.Column="1" Classes="mono muted"
                                       Text="{Binding UpdateInfo.DownloadProgress, StringFormat='{}{0}%'}" />
                        </Grid>
                        <ProgressBar Value="{Binding UpdateInfo.DownloadProgress}" />
                        <TextBlock Classes="muted" Text="The installer reopens on its own once the update is in place." />
                    </StackPanel>
                </Border>
            </Panel>
        </Border>
    </Grid>
</UserControl>
