<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cc="using:SPTInstaller.CustomControls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="460"
             x:Class="SPTInstaller.Views.MessageView">
    <Grid RowDefinitions="Auto,*">
        <!-- Finished -->
        <cc:PageHeader Icon="{StaticResource IconCheckCircle}" IconBrush="{StaticResource SuccessBrush}" Title="Installed"
                       BadgeText="{Binding ReleaseText}" IsVisible="{Binding !HasErrors}" />

        <!-- Stopped -->
        <cc:PageHeader Icon="{StaticResource IconAlertOctagon}" IconBrush="{StaticResource DangerBrush}"
                       Title="Install stopped" IsDanger="True" IsVisible="{Binding HasErrors}">
            <cc:PageHeader.Actions>
                <Button Classes="primary" Command="{Binding RetryCommand}"
                        IsVisible="{Binding RetryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13" />
                        <TextBlock Text="{Binding RetryText}" />
                    </StackPanel>
                </Button>
            </cc:PageHeader.Actions>
        </cc:PageHeader>

        <Border Grid.Row="1" Classes="content">
            <Panel>
                <Border Classes="panel" Padding="24 22" VerticalAlignment="Top" IsVisible="{Binding !HasErrors}">
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <Border Width="60" Height="60" CornerRadius="8" BorderThickness="1" HorizontalAlignment="Center"
                                BorderBrush="{StaticResource Gray700Brush}" Background="{StaticResource TileBrush}"
                                Margin="0 0 0 8">
                            <PathIcon Data="{StaticResource IconCheckCircle}" Width="28" Height="28"
                                      Foreground="{StaticResource SuccessBrush}" />
                        </Border>
                        <TextBlock Classes="h1" Text="{Binding SuccessTitle}" HorizontalAlignment="Center" />
                        <TextBlock Classes="muted" HorizontalAlignment="Center"
                                   Text="{Binding InstallPath, StringFormat='Installed to {0}'}" />

                        <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center" Margin="0 12 0 4"
                                    IsVisible="{Binding ShowOptions}">
                            <CheckBox IsChecked="{Binding AddShortcuts}" Content="Add desktop shortcuts" />
                            <CheckBox IsChecked="{Binding OpenInstallFolder}" Content="Open the install folder" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0 8 0 0">
                            <Button Command="{Binding CopyLogFileToClipboard}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconCopy}" Width="13" Height="13" />
                                    <TextBlock Text="{Binding ClipCommandText}" Foreground="White" />
                                </StackPanel>
                            </Button>
                            <Button Classes="primary" Content="Close" Command="{Binding CloseCommand}" MinWidth="90"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Spacing="4" HorizontalAlignment="Center" Margin="0 14 0 0" IsVisible="{Binding IsLinux}">
                            <TextBlock Classes="muted" FontSize="12" HorizontalAlignment="Center"
                                       Text="The SPT launcher asks for umu, Proton and your Wine prefix when it first opens" />
                            <Button Classes="link" Content="Open the community Linux guide (unofficial)" FontSize="12" HorizontalAlignment="Center"
                                    Command="{Binding OpenLinuxGuideCommand}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0 14 0 0"
                                    IsVisible="{Binding ShowCache}">
                            <TextBlock Classes="muted" FontSize="12"
                                       Text="{Binding CacheInfoText, StringFormat='Download cache {0}, kept for reinstalls'}" />
                            <Button Classes="link" Content="Clear" FontSize="12" Command="{Binding ClearCacheCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Stopped -->
                <Grid ColumnDefinitions="1.4*,*" IsVisible="{Binding HasErrors}">
                    <cc:InfoCard Kind="danger" Title="What happened"
                                 Text="{Binding Message}" VerticalAlignment="Top" Margin="0 0 12 0" />
                    <Border Grid.Column="1" Classes="panel" VerticalAlignment="Top">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="h2" Text="Need help?" Margin="0" />
                            <TextBlock Classes="body" Text="{Binding HelpText}" />
                            <Button Command="{Binding CopyLogFileToClipboard}" HorizontalAlignment="Stretch" Margin="0 6 0 0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconCopy}" Width="13" Height="13" />
                                    <TextBlock Text="{Binding ClipCommandText}" Foreground="White" />
                                </StackPanel>
                            </Button>
                            <Button Content="Linux troubleshooting (unofficial)" Command="{Binding OpenLinuxTroubleshootingCommand}"
                                    HorizontalAlignment="Stretch" IsVisible="{Binding IsLinux}" />
                            <Button Content="Close" Command="{Binding CloseCommand}" HorizontalAlignment="Stretch"
                                    IsVisible="{Binding ShowCloseButton}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Panel>
        </Border>
    </Grid>
</UserControl>
